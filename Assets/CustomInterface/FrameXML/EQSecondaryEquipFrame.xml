<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="EQSecondaryEquipFrame.lua"/>
	<!-- Secondary Class Equipment window (EQWOW / mod-everquest).  Opens to the right of the CharacterFrame
	     via the third right-side tab and mirrors the paper doll layout for a non-active secondary EQ class. -->
	<Frame name="EQSecondaryEquipFrame" parent="CharacterFrame" enableMouse="true" hidden="true">
		<Size>
			<AbsDimension x="384" y="512"/>
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="CharacterFrame" relativePoint="TOPRIGHT">
				<Offset>
					<AbsDimension x="10" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<HitRectInsets>
			<AbsInset left="0" right="30" top="0" bottom="75"/>
		</HitRectInsets>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture file="Interface\PaperDollInfoFrame\UI-Character-CharacterTab-L1">
					<Size>
						<AbsDimension x="256" y="256"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
				<Texture file="Interface\PaperDollInfoFrame\UI-Character-CharacterTab-R1">
					<Size>
						<AbsDimension x="128" y="256"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="256" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture file="Interface\PaperDollInfoFrame\UI-Character-CharacterTab-BottomLeft">
					<Size>
						<AbsDimension x="256" y="256"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="0" y="-256"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture file="Interface\PaperDollInfoFrame\UI-Character-CharacterTab-BottomRight">
					<Size>
						<AbsDimension x="128" y="256"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="256" y="-256"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="EQSecondaryEquipFramePortrait">
					<Size>
						<AbsDimension x="60" y="60"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="7" y="-6"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="EQSecondaryEquipFrameTitle" inherits="GameFontNormal" text="Secondary Class Equipment">
					<Size>
						<AbsDimension x="300" y="12"/>
					</Size>
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="6" y="-19"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="EQSecondaryEquipFrameCloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="CENTER" relativeTo="EQSecondaryEquipFrame" relativePoint="TOPRIGHT">
						<Offset>
							<AbsDimension x="-44" y="-25"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
			<!-- Sits where the title dropdown lives on the paper doll; lists the non-active secondary EQ classes -->
			<Frame name="EQSecondaryEquipFrameClassDropDown" inherits="UIDropDownMenuTemplate">
				<Anchors>
					<Anchor point="TOP">
						<Offset>
							<AbsDimension x="-7" y="-43"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad function="EQSecondaryEquipFrame_OnLoad"/>
			<OnShow function="EQSecondaryEquipFrame_OnShow"/>
			<OnHide function="EQSecondaryEquipFrame_OnHide"/>
			<OnEvent function="EQSecondaryEquipFrame_OnEvent"/>
		</Scripts>
	</Frame>
</Ui>
