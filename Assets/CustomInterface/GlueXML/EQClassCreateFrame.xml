<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- Generated by EQWOWConverter (EQClassCreateLUA) - the WOW class to EQ class map -->
	<Script file="EQClassCreateData.lua"/>
	<Script file="EQClassCreateFrame.lua"/>
	<!--
		EQ class info box for the character creation screen.  Sits immediately to the left of the stock
		CLASS info box and is refreshed by SetCharacterClass() in CharacterCreate.lua.  Deliberately built
		as a twin of CharacterCreateCharacterRace / CharacterCreateCharacterClass - same size, same
		InfoBox artwork, same backdrop, same fonts, same scroll frame geometry - so it reads as part of
		that column.  The content runs longer than the box, so like its neighbors it scrolls, and the
		scroll bar sits in the channel the InfoBox art provides for it.

		The backdrop is tinted per faction by SetCharacterRace(); this frame is listed in
		FRAMES_TO_BACKDROP_COLOR in CharacterCreate.lua so it darkens along with its neighbors.
	-->
	<Frame name="EQClassCreateInfo" parent="CharacterCreateFrame">
		<Size x="267" y="287"/>
		<Anchors>
			<Anchor point="TOPRIGHT" relativeTo="CharacterCreateCharacterClass" relativePoint="TOPLEFT" x="-4" y="0"/>
		</Anchors>
		<Layers>
			<Layer level="BORDER">
				<!--
					Round version of the icon the in-game "EverQuest Classes" character pane side tab uses
					(CharacterFrameSideTabEQ in FrameXML/CharacterFrame.xml).  The box's ring art is an open
					ring rather than a mask, so a square icon shows its corners - this one is pre-cropped
					and masked with the stock race portrait's alpha.  Shipped by the converter, see
					AssetConverter.CopyCharacterCreateEQTextures.
				-->
				<Texture name="EQClassCreateInfoIcon" file="Interface\Glues\CharacterCreate\UI-EQClassCreate-Icon">
					<Size x="48" y="48"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="4" y="-4"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture file="Interface\Glues\CharacterCreate\UI-CharacterCreate-InfoBox" setAllPoints="true">
					<TexCoords left="0.005859375" right="0.52734375" top="0.005859375" bottom="0.56640625"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString name="EQClassCreateInfoTitle" inherits="FactionName_Shadow_Huge" justifyH="LEFT" text="EVERQUEST CLASSES">
					<Size x="220" y="0"/>
					<Anchors>
						<Anchor point="TOP" x="40" y="-10"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background">
			<BackgroundInsets>
				<AbsInset left="12" right="3" top="20" bottom="6"/>
			</BackgroundInsets>
		</Backdrop>
		<Frames>
			<!-- Same geometry as CharacterCreateClassScrollFrame so the scroll bar lands in the art's channel -->
			<ScrollFrame name="EQClassCreateInfoScrollFrame" inherits="GlueScrollFrameTemplate">
				<Size x="220" y="220"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="20" y="-55"/>
				</Anchors>
				<Scripts>
					<OnLoad>
						EQClassCreateInfoScrollFrameScrollBar:ClearAllPoints();
						EQClassCreateInfoScrollFrameScrollBar:SetPoint("TOPLEFT", EQClassCreateInfoScrollFrame, "TOPRIGHT", 7, 4);
						EQClassCreateInfoScrollFrameScrollBar:SetPoint("BOTTOMLEFT", EQClassCreateInfoScrollFrame, "BOTTOMRIGHT", 7, 12);
						GlueScrollFrame_OnScrollRangeChanged(self, yrange);
					</OnLoad>
					<OnScrollRangeChanged>
						GlueScrollFrame_OnScrollRangeChanged(self, yrange);
					</OnScrollRangeChanged>
				</Scripts>
				<ScrollChild>
					<Frame name="EQClassCreateInfoScrollChild">
						<Size x="220" y="10"/>
						<Layers>
							<Layer level="BACKGROUND">
								<FontString name="EQClassCreateInfoPrimaryHeader" inherits="GlueFontNormalSmall" justifyH="LEFT" text="Primary EQ Class">
									<Size x="220" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" x="0" y="0"/>
									</Anchors>
								</FontString>
								<FontString name="EQClassCreateInfoPrimaryText" inherits="GlueFontHighlight" justifyH="LEFT">
									<Size x="208" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" relativeTo="EQClassCreateInfoPrimaryHeader" relativePoint="BOTTOMLEFT" x="12" y="-4"/>
									</Anchors>
								</FontString>
								<FontString name="EQClassCreateInfoSecondaryHeader" inherits="GlueFontNormalSmall" justifyH="LEFT" text="Available Secondary Classes">
									<Size x="220" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" relativeTo="EQClassCreateInfoPrimaryText" relativePoint="BOTTOMLEFT" x="-12" y="-12"/>
									</Anchors>
								</FontString>
								<FontString name="EQClassCreateInfoSecondaryText" inherits="GlueFontHighlight" justifyH="LEFT">
									<Size x="208" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" relativeTo="EQClassCreateInfoSecondaryHeader" relativePoint="BOTTOMLEFT" x="12" y="-4"/>
									</Anchors>
								</FontString>
								<FontString name="EQClassCreateInfoFootnote" inherits="GlueFontCharacterCreate" justifyH="LEFT">
									<Size x="220" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" relativeTo="EQClassCreateInfoSecondaryText" relativePoint="BOTTOMLEFT" x="-12" y="-14"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
		</Frames>
		<Scripts>
			<OnLoad function="EQClassCreateInfo_OnLoad"/>
			<OnShow function="EQClassCreateInfo_OnShow"/>
		</Scripts>
	</Frame>
	<!--
		EverQuest Origins box: the zone this race/class combination starts in, and whether the character
		will be aligned Good, Neutral, or Evil.  Mirrors the EVERQUEST CLASSES box on the other side of
		the screen: same artwork, same scroll geometry, anchored beside the customization column at the
		same height (that column's top is -5 from the frame top, the info boxes' tops are -415).
		Data comes from EQ_CREATE_STARTINFO in the generated EQClassCreateData.lua; the icon swaps with
		the alignment (see EQAlignmentInfo_Update in EQClassCreateFrame.lua).
	-->
	<Frame name="EQAlignmentInfo" parent="CharacterCreateFrame">
		<Size x="267" y="287"/>
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="CharacterCreateConfigurationFrame" relativePoint="TOPRIGHT" x="4" y="-410"/>
		</Anchors>
		<Layers>
			<Layer level="BORDER">
				<!-- Swapped per alignment between UI-EQAlign-Good / -Neutral / -Evil (round-masked like the class box icon) -->
				<Texture name="EQAlignmentInfoIcon" file="Interface\Glues\CharacterCreate\UI-EQAlign-Neutral">
					<Size x="48" y="48"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="4" y="-4"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture file="Interface\Glues\CharacterCreate\UI-CharacterCreate-InfoBox" setAllPoints="true">
					<TexCoords left="0.005859375" right="0.52734375" top="0.005859375" bottom="0.56640625"/>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString name="EQAlignmentInfoTitle" inherits="FactionName_Shadow_Huge" justifyH="LEFT" text="EVERQUEST ORIGINS">
					<Size x="220" y="0"/>
					<Anchors>
						<Anchor point="TOP" x="40" y="-10"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background">
			<BackgroundInsets>
				<AbsInset left="12" right="3" top="20" bottom="6"/>
			</BackgroundInsets>
		</Backdrop>
		<Frames>
			<ScrollFrame name="EQAlignmentInfoScrollFrame" inherits="GlueScrollFrameTemplate">
				<Size x="220" y="220"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="20" y="-55"/>
				</Anchors>
				<Scripts>
					<OnLoad>
						EQAlignmentInfoScrollFrameScrollBar:ClearAllPoints();
						EQAlignmentInfoScrollFrameScrollBar:SetPoint("TOPLEFT", EQAlignmentInfoScrollFrame, "TOPRIGHT", 7, 4);
						EQAlignmentInfoScrollFrameScrollBar:SetPoint("BOTTOMLEFT", EQAlignmentInfoScrollFrame, "BOTTOMRIGHT", 7, 12);
						GlueScrollFrame_OnScrollRangeChanged(self, yrange);
					</OnLoad>
					<OnScrollRangeChanged>
						GlueScrollFrame_OnScrollRangeChanged(self, yrange);
					</OnScrollRangeChanged>
				</Scripts>
				<ScrollChild>
					<Frame name="EQAlignmentInfoScrollChild">
						<Size x="220" y="10"/>
						<Layers>
							<Layer level="BACKGROUND">
								<FontString name="EQAlignmentInfoZoneHeader" inherits="GlueFontNormalSmall" justifyH="LEFT" text="Starting Zone">
									<Size x="220" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" x="0" y="0"/>
									</Anchors>
								</FontString>
								<FontString name="EQAlignmentInfoZoneText" inherits="GlueFontHighlight" justifyH="LEFT">
									<Size x="208" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" relativeTo="EQAlignmentInfoZoneHeader" relativePoint="BOTTOMLEFT" x="12" y="-4"/>
									</Anchors>
								</FontString>
								<FontString name="EQAlignmentInfoAlignHeader" inherits="GlueFontNormalSmall" justifyH="LEFT" text="Alignment">
									<Size x="220" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" relativeTo="EQAlignmentInfoZoneText" relativePoint="BOTTOMLEFT" x="-12" y="-12"/>
									</Anchors>
								</FontString>
								<FontString name="EQAlignmentInfoAlignText" inherits="GlueFontHighlight" justifyH="LEFT">
									<Size x="208" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" relativeTo="EQAlignmentInfoAlignHeader" relativePoint="BOTTOMLEFT" x="12" y="-4"/>
									</Anchors>
								</FontString>
								<FontString name="EQAlignmentInfoAlignDesc" inherits="GlueFontCharacterCreate" justifyH="LEFT">
									<Size x="220" y="0"/>
									<Anchors>
										<Anchor point="TOPLEFT" relativeTo="EQAlignmentInfoAlignText" relativePoint="BOTTOMLEFT" x="-12" y="-14"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
		</Frames>
		<Scripts>
			<OnShow function="EQAlignmentInfo_OnShow"/>
		</Scripts>
	</Frame>
</Ui>
